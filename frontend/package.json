{
  "name": "sim-atlas-frontend",
  "version": "0.1.0",
  "description": "React frontend for sim-atlas platform with interactive search and visualization",
  "author": {
    "name": "Sebastian Eibl",
    "email": "sebastian.eibl@mpcdf.mpg.de"
  },
  "keywords": [
    "react",
    "fastapi",
    "workflow",
    "simulation",
    "visualization"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "axios": "^1.13.5",
    "lucide-react": "^1.27.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^8.3.0",
    "shadcn": "^4.0.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.0",
    "knip": "^6.31.0",
    "msw": "^2.14.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
