#!/usr/bin/env bash
# Install or update all dependencies. Safe to re-run.
set -euo pipefail
cd "$(dirname "$0")/.."

for tool in uv npm; do
  if ! command -v "$tool" >/dev/null; then
    echo "error: '$tool' not found on PATH" >&2
    exit 1
  fi
done

# --all-extras: the backend's embedding providers are extras, and the generated
# config enables fastembed.
echo "==> uv sync --all-extras (backend)"
(cd backend && uv sync --all-extras)
echo "==> uv sync (toolkit)"
(cd toolkit && uv sync)
echo "==> uv sync (models)"
(cd models && uv sync)

for d in api_schema frontend web_ide e2e; do
  echo "==> npm ci ($d)"
  (cd "$d" && npm ci)
done
