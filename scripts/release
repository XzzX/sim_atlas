#!/usr/bin/env bash
# Cut a release: bump the version of every Python package, commit, tag and push.
# Pushing the tag triggers .github/workflows/release.yml, which builds and publishes to PyPI.
# Usage: scripts/release <patch|minor|major|X.Y.Z>
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -ne 1 ]; then
  echo "usage: $0 <patch|minor|major|X.Y.Z>" >&2
  exit 2
fi

echo "==> checks"
if [ -n "$(git status --porcelain)" ]; then
  echo "error: working tree is not clean" >&2
  exit 1
fi
if [ "$(git branch --show-current)" != main ]; then
  echo "error: not on main" >&2
  exit 1
fi
git fetch --quiet --tags origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "error: main is not in sync with origin/main" >&2
  exit 1
fi

case "$1" in
  patch | minor | major) bump=(--bump "$1") ;;
  *) bump=("$1") ;;
esac
version=$(cd backend && uv version --dry-run --short "${bump[@]}")
tag="v$version"
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
  echo "error: tag $tag already exists" >&2
  exit 1
fi

# Released in lockstep; models comes first because the others pin it exactly.
packages=(models backend toolkit)

echo "==> bump version to $version"
for d in "${packages[@]}"; do
  (cd "$d" && uv version --no-sync "$version")
done

echo "==> pin sim-atlas-models==$version"
for d in "${packages[@]}"; do
  if grep -q '"sim-atlas-models==' "$d/pyproject.toml"; then
    sed -i -E "s/\"sim-atlas-models==[^\"]*\"/\"sim-atlas-models==$version\"/" "$d/pyproject.toml"
    (cd "$d" && uv lock --quiet)
  fi
done

for d in "${packages[@]}"; do
  git add "$d/pyproject.toml" "$d/uv.lock"
done
git commit --quiet -m "Release $tag"
git tag -a "$tag" -m "$tag"

read -r -p "Push $tag to origin (publishes to PyPI)? [y/N] " answer
if [ "$answer" != y ]; then
  echo "Not pushed. Undo with: git tag -d $tag && git reset --hard HEAD~1"
  exit 1
fi
git push --atomic origin main "$tag"
echo "Pushed $tag. Follow the release at https://github.com/XzzX/sim_atlas/actions/workflows/release.yml"
